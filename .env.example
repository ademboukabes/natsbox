# === Database ===
# asyncpg DSN — must use postgresql+asyncpg:// scheme
OUTBOX_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/myapp

# === NATS ===
OUTBOX_NATS_URL=nats://localhost:4222

# === Relay (Polling) ===
# How often (seconds) to poll for pending events when idle
OUTBOX_POLLING_INTERVAL=1.0

# Max events fetched per tick (SELECT ... LIMIT)
OUTBOX_BATCH_SIZE=100

# Max publish attempts before an event is dead-lettered (status=failed)
OUTBOX_MAX_RETRIES=5

# === Retention ===
# Published events older than this are eligible for cleanup
OUTBOX_RETENTION_DAYS=7

# === NATS JetStream deduplication window (seconds) ===
# Must match the MaxAge/DuplicateWindow configured on your JetStream stream.
# NATS dedup uses the Nats-Msg-Id header; our relay always sets it to event_id
# (stable across retries), so retried publishes are idempotent within this window.
OUTBOX_JETSTREAM_DEDUP_WINDOW=120

# === Observability ===
# Port to expose Prometheus metrics (0 = disabled)
OUTBOX_METRICS_PORT=9090
